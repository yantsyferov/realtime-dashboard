{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "installCommand": "npm ci && npm --prefix wasm-producer ci",
  "buildCommand": "npm run build && npm test -- --watch=false",
  "outputDirectory": "dist/realtime-dashboard/browser",
  "rewrites": [
    {
      "source": "/settings",
      "destination": "/index.html"
    }
  ]
}
